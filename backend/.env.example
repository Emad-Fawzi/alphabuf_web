# انسخ الملف ده لاسم ".env" وحط مفاتيحك الحقيقية (اختياري - الأداة شغالة من غيره،
# بس ميزة تحليل الأخبار بالـ AI محتاجاه). السيرفر بيقرا environment variables عادي،
# فممكن تحطهم كـ .env، أو مباشرة في إعدادات الاستضافة (Render/Railway/إلخ).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# حساب لوحة الإدارة: لا تضع هذه القيم في GitHub. اختر كلمة مرور طويلة وفريدة (12 حرفاً فأكثر).
# بدون القيمتين، لن يستطيع أي حساب فتح لوحة الإدارة.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# اجعلها true بعد النشر على HTTPS؛ اتركها فارغة للتشغيل المحلي عبر http://localhost.
COOKIE_SECURE=true

# على Render: اربط Persistent Disk على /var/data ثم اضبط هذا المتغير لحفظ الحسابات والمفضلات والزيارات بعد كل Deploy.
APP_DATA_DIR=/var/data
